# Google Cloud project registered for Earth Engine (required).
# Authenticate once on the machine with:  earthengine authenticate
GEE_PROJECT=your-gee-project-id

# Hosted copies: a service-account JSON key, passed as a secret instead of the machine login
# GEE_SERVICE_ACCOUNT_KEY=

# Where jobs are stored (default: ./data)
# JALDRISHTI_DATA_DIR=./data

# Sign-in (optional). Off by default; set JALDRISHTI_REQUIRE_LOGIN=true and an admin password to switch it on.
# JALDRISHTI_REQUIRE_LOGIN=true
# JALDRISHTI_ADMIN_USER=admin
# JALDRISHTI_ADMIN_PASSWORD=
# JALDRISHTI_SECRET_KEY=
# JALDRISHTI_USERS_REPO=
# JALDRISHTI_USERS_TOKEN=
